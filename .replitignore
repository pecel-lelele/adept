# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
__pycache__
.pytest_cache
generated-artifacts

# Never ship developer configuration or local secrets in a deployment image; production
# reads its settings from Replit Secrets (and the API skips .env when APP_ENV=production).
.env
.env.*
!.env.example
.session-secret
