# Copy to .env (make setup does this). Never commit .env.

# --- auth ---
# demo: local accounts, created through sign-up and stored in PostgreSQL.
AUTH_MODE=demo

# --- database ---
# Deployment: Replit provides the managed PostgreSQL DATABASE_URL in its environment.
# Local development only: the Docker Compose settings and loopback URL below.
POSTGRES_USER=adept
# Required by docker-compose. This local-only value matches DATABASE_URL below, so `make setup`
# works on a fresh machine (the container is bound to 127.0.0.1). Change both together, and use
# a strong random value in any shared environment. If the password contains URL-special
# characters (@ : / ? # [ ]), URL-encode it in DATABASE_URL (e.g. @ → %40) but not here.
# A volume created with an older password keeps it: update DATABASE_URL or recreate the volume.
POSTGRES_PASSWORD=adept-local-only
POSTGRES_DB=adept
POSTGRES_PORT=5433
# Host address the database port is published on. Keep 127.0.0.1 unless you mean to
# expose the database to other machines (then also change POSTGRES_PASSWORD).
POSTGRES_BIND=127.0.0.1
# 127.0.0.1, not localhost: the port is published on IPv4 loopback only, and "localhost"
# may try IPv6 first (a 5 s connect delay on Windows).
DATABASE_URL=postgresql://adept:adept-local-only@127.0.0.1:5433/adept

# --- api ---
# production: the API refuses to start without SESSION_SECRET (32+ chars), exact CORS origins,
# WEB_ORIGIN, PROXY_SHARED_SECRET, M3_BACKEND=postgres and no test-only auth switches; it hides
# /docs and never reads this .env file (use the platform's secrets). Use development locally.
APP_ENV=development
API_PORT=8000
# Pooled PostgreSQL connections per API process (hosted databases cap total connections).
DB_POOL_MAX=10
# Exact public browser origin, without a trailing slash. Required in production: the web
# server uses it for same-origin checks (preview, logout, workspace switch) and never trusts
# forwarded host headers when it is set.
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- security (F8) ---
# Per-IP sliding-window limit for routes without a tighter bucket (requests per window).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=600
RATE_LIMIT_WINDOW_S=60
# Request body caps in bytes: CV uploads and everything else.
MAX_UPLOAD_BYTES=5242880
MAX_JSON_BYTES=1048576
# Shared secret the web server sends with X-Real-IP so the API rate-limits per real client.
# Required in production; must match on the public Next.js server and private API.
PROXY_SHARED_SECRET=
# trusted requires a verified positive hop count in production. best-effort permits 0
# but then ignores X-Forwarded-For: anonymous requests share the API's direct-peer bucket.
# Positive hops select from the right: 1 = last XFF entry, 2 = second-last, etc.
# Configure only after verifying every ingress path appends/overwrites the trusted suffix.
# The shared secret is required in both modes. Authenticated limits use verified session IDs.
PROXY_CLIENT_IP_MODE=best-effort
# Development with 0 never forwards client identity, regardless of mode.
# Replit production uses 1 (right-most entry, appended by Replit's edge).
TRUSTED_PROXY_HOPS=0
# Temporary opt-in diagnostic, web server only: log XFF entry count, never addresses/values.
# Disable after owner verification; see docs/replit-proxy-verification.md.
PROXY_LOG_XFF_COUNT=false

# --- storage and live data ---
# postgres (default): accounts, profiles, organisations, plans, progress, badges, rate limits
# and reference data live in DATABASE_URL, shared by every API instance and kept across
# restarts. Run `make db-migrate` and `make seed` first.
# csv: seed files + in-memory state. Used by the automated tests only (tests/conftest.py);
# APP_ENV=production refuses to start with csv.
M3_BACKEND=postgres
# Signs session tokens for sign-up / sign-in (AUTH_MODE=demo local accounts). Set a long
# random value in any shared deployment; empty = a random key kept in .session-secret
# (gitignored), or in memory when that file can't be written.
# Required by the full-stack docker-compose.yml API (32+ characters for production).
# Database-only commands use docker-compose.db.yml and do not require this value.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Secret for POST /api/v1/pathway/catalogue/sync and /api/v1/sdg/sync (header X-Sync-Token),
# which refresh the catalogue and SDG list from their live APIs. Empty = sync endpoints off.
SYNC_TOKEN=

# --- web ---
# Server-side base URL the Next.js app uses to call the API.
API_URL=http://localhost:8000
# Operator-provisioned stable account IDs, not unverified signup emails. Empty denies all.
ADMIN_USER_IDS=
# Server-only fine-grained token, this repository only, Actions read/write; never NEXT_PUBLIC.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=pecel-lelele/adept
TRENDS_REFRESH_WORKFLOW=trends-refresh.yml
GITHUB_DISPATCH_REF=main

# --- llm: Adi, the in-app assistant (F8 gateway) ---
# none (default): Adi answers with its built-in guide; no model is called.
# replit: Replit AI Integrations, billed to Replit credits (paid plan). Replit injects
#   AI_INTEGRATIONS_OPENAI_BASE_URL / _API_KEY into apps running on Replit; leave the two
#   below empty there. Set LLM_MODEL, e.g. gpt-5.4-mini.
# runpod: put the key in RUNPOD_API_KEY (API server only), never NEXT_PUBLIC_*.
# For the GLM-5.3 public endpoint, configure:
# LLM_PROVIDER=runpod
# LLM_MODEL=glm-5.3
# LLM_BASE_URL=https://api.runpod.ai/v2/b1dd8hy2hqo1nb/openai/v1
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
# GEMINI_API_KEY=<your existing Gemini key>
# Requests use reasoning_effort=low and a capped output. No Pod deployment is needed.
# gemini: Google AI Studio key in GEMINI_API_KEY (LLM_API_KEY is not used for gemini or runpod). Free tier: gemini-3.5-flash-lite (15 req/min,
#   ~2 s answers) with gemini-3.6-flash,gemini-3.1-flash-lite as fallbacks.
# openai | openrouter | openai_compatible: their API key (and base URL for openai_compatible).
# The provider and model are shown on /about and must be named in the README when enabled.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Separate provider credentials. Never reuse a Runpod key at Google's endpoint or vice versa.
RUNPOD_API_KEY=
GEMINI_API_KEY=
# Empty fallback provider: the model list uses the primary endpoint (legacy behaviour).
# gemini: use the separate GEMINI_API_KEY; try it only after a primary failure/timeout.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_S=20

# Optional local integration tests only: creates/drops a separate synthetic database.
# ADEPT_TEST_PG_ADMIN_URL=postgresql://adept:adept-local-only@127.0.0.1:5433/postgres

# Live job openings pipeline (src/pipelines/jobs). Optional: each keyed job board runs only
# when its free publisher key is set; without one it is skipped. Never commit real keys.
CAREERJET_API_KEY=
# Careerjet locale for the keyed search (default en_MY: Malaysian listings).
CAREERJET_LOCALE=en_MY
JOOBLE_API_KEY=
WEB3_CAREER_TOKEN=

# Cosine-similarity skill suggestions for CV phrases outside the catalogue. gemini = Gemini
# embeddings (uses GEMINI_API_KEY, 768 dimensions, vectors stored with pgvector); none = off.
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=gemini-embedding-001

# --- MiniLM RunPod encoder (F2 offline trend pipeline only) ---
# The worker image is published automatically to ghcr.io/pecel-lelele/adept-minilm:latest
# by the publish-minilm.yml workflow whenever src/pipelines/trends/runpod/ changes.
# Set these in the process running the trend pipeline (never in browser code / NEXT_PUBLIC_*):
#   runpod  (default): uses a RunPod Serverless endpoint — set the two variables below.
#   local:             downloads the model locally (sentence-transformers required; dev only).
TRENDS_EMBEDDING_BACKEND=runpod
# The short endpoint ID shown in the RunPod dashboard (e.g. abc1def2ghi3). Not a full URL.
TRENDS_RUNPOD_ENDPOINT_ID=
# A RunPod API key scoped to this endpoint. Keep in .env / secrets, never in source.
TRENDS_RUNPOD_API_KEY=
# Maximum seconds to wait for a cold-start worker (default 600, max 900).
TRENDS_RUNPOD_TIMEOUT_SECONDS=600
# For reference: the published image RunPod pulls from (set in RunPod console, not here).
# MINILM_IMAGE=ghcr.io/pecel-lelele/adept-minilm:latest

# Optional public build identity when the deployment has no Git checkout (full 40-char SHA).
BUILD_REVISION=

# Hide team heatmap values below this many consenting completed-intake members.
ORG_MIN_COHORT=3

# Seconds the public /impact summary is reused before being recomputed (0 = every request).
IMPACT_SUMMARY_TTL_S=120

# In-app live data refresh (admins listed in ADMIN_USER_IDS; POST /api/v1/data/refresh/{source}).
# Optional: total time budget in seconds for one refresh run (default 90, clamped to 10-300).
# Keyed job boards run only when CAREERJET_API_KEY / JOOBLE_API_KEY / WEB3_CAREER_TOKEN are set.
DATA_REFRESH_BUDGET_S=90
# Scheduler credential is independent of accounts, SYNC_TOKEN and model-provider keys.
# Set privately in Replit Secrets and GitHub Actions secrets. Never put its value here.
DATA_REFRESH_TOKEN=
TRENDS_STALE_DAYS=10
# Ads older than this observation window remain labelled on the board, excluded from counts.
JOBS_STALE_DAYS=14
TRENDS_REFRESH_COOLDOWN_MINUTES=10
# After a FAILED trends step, signed-in non-admin checks skip the paid RunPod/MiniLM trends
# step for this many minutes (other sources still refresh). Admins and the scheduler are exempt.
TRENDS_FAILURE_BACKOFF_MINUTES=60
# GitHub repository variable (not an API secret): DATA_REFRESH_APP_URL=https://your-app.example
