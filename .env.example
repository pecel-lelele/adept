# Copy to .env (make setup does this). Never commit .env.

# --- auth ---
# demo: no signup; /demo/learner and /demo/org sign in as synthetic personas.
# supabase: Authorization: Bearer <Supabase access token>, verified with SUPABASE_JWT_SECRET.
AUTH_MODE=demo
# Supabase project JWT secret (Settings -> API). Required when AUTH_MODE=supabase; never commit it.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- database (docker-compose) ---
POSTGRES_USER=adept
POSTGRES_PASSWORD=adept
POSTGRES_DB=adept
POSTGRES_PORT=5433
# Host address the database port is published on. Keep 127.0.0.1 unless you mean to
# expose the database to other machines (then also change POSTGRES_PASSWORD).
POSTGRES_BIND=127.0.0.1
# 127.0.0.1, not localhost: the port is published on IPv4 loopback only, and "localhost"
# may try IPv6 first (a 5 s connect delay on Windows).
DATABASE_URL=postgresql://adept:adept@127.0.0.1:5433/adept

# --- api ---
# production: the API refuses to start without SESSION_SECRET (32+ chars), exact CORS origins and
# no test-only auth switches, and hides /docs. Use development locally.
APP_ENV=development
API_PORT=8000
# Pooled PostgreSQL connections per API process (hosted databases cap total connections).
DB_POOL_MAX=10
# Exact browser origin allowed to submit the anonymous preview.
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- security (F8) ---
# Per-IP sliding-window limit for routes without a tighter bucket (requests per window).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=600
RATE_LIMIT_WINDOW_S=60
# Request body caps in bytes: CV uploads and everything else.
MAX_UPLOAD_BYTES=5242880
MAX_JSON_BYTES=1048576
# Shared secret the web server sends with X-Real-IP so the API rate-limits per real client.
# Leave empty if the browser calls the API directly. Must match on web and API.
PROXY_SHARED_SECRET=
# Web only: how many trusted proxies in front of Next.js append to X-Forwarded-For
# (1 for a single platform load balancer). 0 = never forward a client address, because a
# caller can write anything into the left of that header.
TRUSTED_PROXY_HOPS=0

# --- storage and live data ---
# postgres (default): accounts, profiles, organisations, plans, progress, badges, rate limits
# and reference data live in DATABASE_URL, shared by every API instance and kept across
# restarts. Run `make db-migrate` and `make seed` first.
# csv: seed files + in-memory state. Used by the automated tests only (tests/conftest.py).
M3_BACKEND=postgres
# Signs session tokens for sign-up / sign-in (AUTH_MODE=demo local accounts). Set a long
# random value in any shared deployment; empty = a random key kept in .session-secret
# (gitignored), or in memory when that file can't be written.
SESSION_SECRET=
# Secret for POST /api/v1/pathway/catalogue/sync and /api/v1/sdg/sync (header X-Sync-Token),
# which refresh the catalogue and SDG list from their live APIs. Empty = sync endpoints off.
SYNC_TOKEN=

# --- web ---
# Server-side base URL the Next.js app uses to call the API.
API_URL=http://localhost:8000
# Emails allowed to open the internal /admin data pages (comma-separated). Empty: any signed-in
# account in development, nobody in production.
ADMIN_EMAILS=

# --- llm: Adi, the in-app assistant (F8 gateway) ---
# none (default): Adi answers with its built-in guide; no model is called.
# replit: Replit AI Integrations, billed to Replit credits (paid plan). Replit injects
#   AI_INTEGRATIONS_OPENAI_BASE_URL / _API_KEY into apps running on Replit; leave the two
#   below empty there. Set LLM_MODEL, e.g. gpt-5.4-mini.
# runpod: LLM_BASE_URL=https://api.runpod.ai/v2/<endpoint-id>/openai/v1, LLM_API_KEY=<Runpod key>.
# gemini: Google AI Studio key in LLM_API_KEY. Free tier: gemini-3.5-flash-lite (15 req/min,
#   ~2 s answers) with gemini-3.6-flash,gemini-3.1-flash-lite as fallbacks.
# openai | openrouter | openai_compatible: their API key (and base URL for openai_compatible).
# The provider and model are shown on /about and must be named in the README when enabled.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Comma-separated models tried when LLM_MODEL is rate-limited or failing.
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=20

# Optional local integration tests only: creates/drops a separate synthetic database.
# ADEPT_TEST_PG_ADMIN_URL=postgresql://adept:adept@127.0.0.1:5433/postgres
