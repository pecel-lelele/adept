{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "src/api",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "src/api"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/web-dev.cjs"
      ],
      "port": 3000
    }
  ]
}
