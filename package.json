{
  "name": "adept",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "python src/scripts/dev.py dev",
    "build": "pnpm --filter @workspace/adept build",
    "start": "python src/scripts/replit.py start",
    "lint": "pnpm --filter @workspace/adept lint",
    "typecheck": "pnpm --filter @workspace/adept typecheck",
    "check": "python src/scripts/dev.py check",
    "test:proxy": "node --experimental-strip-types --test tests/web-proxy.test.ts",
    "contracts": "python src/scripts/dev.py contracts"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "openapi-typescript": "7.9.1"
  },
  "packageManager": "pnpm@10.29.3",
  "type": "module"
}
